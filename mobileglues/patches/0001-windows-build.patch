@@ -164,6 +166,25 @@ void glGetProgramiv(GLuint program, GLenum pname, GLint* params) {
         GLES.glGetProgramInfoLog(program, 512, nullptr, infoLog);
 
         LOG_W_FORCE("Program %d linking failed: \n%s", program, infoLog);
+#ifdef MG_WINDOWS
+        // xbox-mc: the driver's link log is often empty, so also dump what each
+        // attached shader turned into (the GLSL ES that went to the driver)
+        GLuint shaders[8];
