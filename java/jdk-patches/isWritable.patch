     private static boolean hasDesiredAccess(WindowsPath file, int rights) throws IOException {
+        // xbox-mc: in the uwp app sandbox the acl check below says no even for
+        // the app's own folders, so first just try to open it with that access
+        try {
+            long h = CreateFile(file.getPathForWin32Calls(), rights,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS);
+            CloseHandle(h);
+            return true;
+        } catch (WindowsException x) {
+            // fall through to the acl check
+        }
